class Solution {
    public int findNumbers(int[] n) {
        int c=0;
        for(int i=0;i < n.length;i++){
            int d=0;
            int n1=n[i];
            while(n1 != 0){
                n1=n1/10;
                d++;

            }
            if(d%2==0){
                c++;
            }
        }
        return c;

        
    }
}
